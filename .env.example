# Copia este archivo a `.env` para desarrollo local.
# En el despliegue NO se sube este archivo: las mismas variables se cargan
# desde el panel del proveedor (Vercel / Render / Railway).
#
# Las 5 marcadas [REQUERIDA] son las mínimas para que el sistema funcione.
# `GET /` te dice cuáles faltan sin exponer ningún valor.

# --- Telegram ---
# [REQUERIDA] Crear con @BotFather en Telegram (2 minutos, gratis, sin límites)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# URL pública HTTPS donde Telegram enviará los updates. Es la URL de TU BACKEND
# (no la del frontend), ej: https://agroia-backend.onrender.com/api/webhook/telegram
TELEGRAM_WEBHOOK_URL=https://tu-backend-publico.com/api/webhook/telegram

# --- Gemini — usado por Agente 1 (extracción) y Agente 3 (ventas) ---
# [REQUERIDA] Desde aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxx
# Un modelo por agente por si conviene ajustar costo/latencia por separado.
GEMINI_MODEL_EXTRACCION=gemini-3.6-flash
GEMINI_MODEL_VENTAS=gemini-3.6-flash

# --- Groq (Speech-to-Text para notas de voz) ---
# [REQUERIDA] Desde console.groq.com (capa gratuita)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_STT_MODEL=whisper-large-v3

# --- Supabase ---
# [REQUERIDA] Panel de Supabase -> Project Settings -> API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# [REQUERIDA] La `service_role` key, NO la `anon` key.
# El backend necesita saltarse Row Level Security para escribir; la anon key
# solo puede leer ofertas activas (ver supabase_schema.sql).
# Esta clave nunca debe llegar a Angular ni al repositorio.
SUPABASE_KEY=eyJhbGciOi...
SUPABASE_TABLE_PRODUCTOS=productos

# --- App ---
APP_ENV=development
# Orígenes del frontend Angular, separados por coma. En producción pon el
# dominio real de Vercel; "*" solo para pruebas locales.
CORS_ALLOW_ORIGINS=https://tu-proyecto.vercel.app
