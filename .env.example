# --- Telegram ---
# Crear con @BotFather en Telegram (2 minutos, gratis, sin límites)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# URL pública HTTPS donde Telegram enviará los updates, ej: https://tuapp.onrender.com/api/webhook/telegram
TELEGRAM_WEBHOOK_URL=https://tu-dominio-publico.com/api/webhook/telegram

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# Alias de modelo recomendado a la fecha de este scaffold; revisa
# https://docs.claude.com/en/docs/about-claude/models para el listado vigente.
CLAUDE_MODEL_EXTRACCION=claude-sonnet-4-5
CLAUDE_MODEL_VENTAS=claude-sonnet-4-5
CLAUDE_MODEL_CLASIFICACION=claude-haiku-4-5

# --- Groq (Speech-to-Text para notas de voz) ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_STT_MODEL=whisper-large-v3

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOi...
SUPABASE_TABLE_PRODUCTOS=productos

# --- App ---
APP_ENV=development
# Orígenes permitidos para el frontend Angular (separados por coma). "*" solo para pruebas locales.
CORS_ALLOW_ORIGINS=*
